{
  "info": {
    "name": "Life-RPG · Pruebas críticas",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Estado · GET /estado",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/estado"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
              "pm.test('base de datos ok', () => pm.expect(pm.response.json().database).to.eql('ok'));",
              "pm.test('responde en menos de 1s', () => pm.expect(pm.response.responseTime).to.be.below(1000));"
            ]
          }
        }
      ]
    },
    {
      "name": "Estado · alias GET /health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('database ok', () => pm.expect(pm.response.json().database).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Contrato · ruta inexistente devuelve 404",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/no-existe"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 404', () => pm.response.to.have.status(404));",
